{
	"name": "@jiujue/weave-devtools-runtime",
	"version": "3.0.1",
	"description": "Weave DevTools runtime：在运行时收集与暴露调试信息。",
	"keywords": [
		"weave",
		"devtools",
		"rendering"
	],
	"homepage": "https://github.com/jiujue/weave/tree/master/packages/devtools-runtime",
	"bugs": {
		"url": "https://github.com/jiujue/weave/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jiujue/weave.git",
		"directory": "packages/devtools-runtime"
	},
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"skills",
		"AI_GUIDE.md",
		"README.md",
		"CHANGELOG.md"
	],
	"dependencies": {
		"@jiujue/weave-types": "workspace:*"
	},
	"scripts": {
		"build": "tsup src/index.ts --format esm --dts --clean",
		"typecheck": "pnpm -w tsc -p packages/devtools-runtime/tsconfig.json --noEmit",
		"test": "node -e \"process.exit(0)\"",
		"lint": "node -e \"process.exit(0)\""
	}
}
