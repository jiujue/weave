{
	"name": "weave-devtools-extension",
	"version": "0.0.0",
	"description": "Weave DevTools extension",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "plasmo dev",
		"build": "plasmo build",
		"package": "plasmo package",
		"test": "node -e \"process.exit(0)\"",
		"lint": "node -e \"process.exit(0)\""
	},
	"dependencies": {
		"plasmo": "^0.90.0",
		"react": "^18.2.0",
		"react-dom": "^18.2.0"
	},
	"devDependencies": {
		"@types/chrome": "^0.0.251",
		"@types/react": "^18.2.0",
		"@types/react-dom": "^18.2.0"
	},
	"manifest": {
		"permissions": [
			"scripting",
			"tabs"
		],
		"host_permissions": [
			"<all_urls>"
		]
	}
}
