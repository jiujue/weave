{
	"name": "@jiujue/weave-react",
	"version": "3.0.0",
	"description": "Weave 的 React 绑定：用 React JSX 构建 SceneNode。",
	"keywords": [
		"weave",
		"react",
		"jsx",
		"rendering",
		"canvas"
	],
	"homepage": "https://github.com/jiujue/weave/tree/master/packages/react",
	"bugs": {
		"url": "https://github.com/jiujue/weave/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jiujue/weave.git",
		"directory": "packages/react"
	},
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"skills",
		"AI_GUIDE.md",
		"README.md",
		"CHANGELOG.md"
	],
	"dependencies": {
		"@jiujue/weave-types": "workspace:*"
	},
	"peerDependencies": {
		"react": "^18.2.0"
	},
	"devDependencies": {
		"@types/react": "^18.2.66"
	},
	"scripts": {
		"build": "tsup src/index.ts --format esm --dts --clean",
		"typecheck": "pnpm -w tsc -p packages/react/tsconfig.json --noEmit",
		"test": "node -e \"process.exit(0)\"",
		"lint": "node -e \"process.exit(0)\""
	}
}
