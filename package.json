{
	"name": "weave",
	"private": true,
	"packageManager": "pnpm@9.15.4",
	"type": "module",
	"scripts": {
		"build": "pnpm -r --workspace-concurrency=1 build",
		"dev": "pnpm -r --filter @jiujue/weave-types --filter @jiujue/weave-react --filter @jiujue/weave-displaylist --filter @jiujue/weave-core --filter @jiujue/weave-devtools-runtime --filter @jiujue/weave-adapter-offscreen --filter @jiujue/weave-app build && pnpm -C apps/demo dev",
		"dev:react": "pnpm -r --filter @jiujue/weave-types --filter @jiujue/weave-react --filter @jiujue/weave-displaylist --filter @jiujue/weave-core --filter @jiujue/weave-devtools-runtime --filter @jiujue/weave-adapter-offscreen --filter @jiujue/weave-app build && pnpm -C apps/demo-react dev",
		"dev:vue3": "pnpm -r --filter @jiujue/weave-types --filter @jiujue/weave-react --filter @jiujue/weave-displaylist --filter @jiujue/weave-core --filter @jiujue/weave-devtools-runtime --filter @jiujue/weave-adapter-offscreen --filter @jiujue/weave-app build && pnpm -C apps/demo-vue3 dev",
		"docs": "pnpm -r --filter @jiujue/weave-types --filter @jiujue/weave-react --filter @jiujue/weave-displaylist --filter @jiujue/weave-core --filter @jiujue/weave-devtools-runtime --filter @jiujue/weave-adapter-offscreen --filter @jiujue/weave-adapter-worker-image --filter @jiujue/weave-app build && pnpm -C apps/docs dev",
		"docs:build": "pnpm -r --filter @jiujue/weave-types --filter @jiujue/weave-react --filter @jiujue/weave-displaylist --filter @jiujue/weave-core --filter @jiujue/weave-devtools-runtime --filter @jiujue/weave-adapter-offscreen --filter @jiujue/weave-adapter-worker-image --filter @jiujue/weave-app build && pnpm -C apps/docs build",
		"docs:preview": "pnpm -C apps/docs preview",
		"test": "vitest run",
		"lint": "pnpm -r lint"
	},
	"devDependencies": {
		"tsup": "^8.5.1",
		"typescript": "^5.9.3",
		"vitest": "^4.0.17"
	}
}
