{
	"name": "weave-demo-vue3",
	"private": true,
	"type": "module",
	"description": "Weave Vue3 demo（使用 @jiujue/weave-adapter-worker-image）。",
	"homepage": "https://github.com/jiujue/weave/tree/master/apps/demo-vue3",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jiujue/weave.git",
		"directory": "apps/demo-vue3"
	},
	"keywords": [
		"weave",
		"demo",
		"vue",
		"webworker"
	],
	"scripts": {
		"predev": "pnpm -C ../../packages/adapter-worker-image build",
		"dev": "vite",
		"prebuild": "pnpm -C ../../packages/adapter-worker-image build",
		"build": "vite build",
		"preview": "vite preview",
		"typecheck": "pnpm -w tsc -p apps/demo-vue3/tsconfig.json --noEmit",
		"test": "node -e \"process.exit(0)\"",
		"lint": "node -e \"process.exit(0)\""
	},
	"dependencies": {
		"@jiujue/weave-app": "workspace:*",
		"@jiujue/weave-adapter-worker-image": "workspace:*",
		"@jiujue/weave-types": "workspace:*",
		"vue": "^3.5.0"
	},
	"devDependencies": {
		"@vitejs/plugin-vue": "^5.2.0",
		"vite": "^5.4.0",
		"typescript": "^5.9.3"
	}
}
