{
	"name": "@jiujue/weave-adapter-worker-image",
	"version": "3.0.2",
	"description": "Weave Worker Image 适配：把渲染放到 Worker，并把结果以 ImageBitmap / ImageData 传回主线程。",
	"keywords": [
		"weave",
		"rendering",
		"webworker",
		"imagebitmap",
		"canvas"
	],
	"homepage": "https://jiujue.github.io/weave/",
	"bugs": {
		"url": "https://github.com/jiujue/weave/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jiujue/weave.git",
		"directory": "packages/adapter-worker-image"
	},
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./worker": {
			"types": "./dist/worker.d.ts",
			"default": "./dist/worker.js"
		}
	},
	"files": [
		"dist",
		"skills",
		"AI_GUIDE.md",
		"README.md",
		"CHANGELOG.md"
	],
	"dependencies": {
		"@jiujue/weave-core": "workspace:*",
		"@jiujue/weave-displaylist": "workspace:*",
		"@jiujue/weave-types": "workspace:*"
	},
	"scripts": {
		"build": "tsup --config tsup.worker.config.ts && tsup",
		"typecheck": "pnpm -w tsc -p packages/adapter-worker-image/tsconfig.json --noEmit",
		"test": "node -e \"process.exit(0)\"",
		"lint": "node -e \"process.exit(0)\""
	}
}
