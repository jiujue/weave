{
	"name": "@jiujue/weave-types",
	"version": "2.0.0",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./jsx-runtime": {
			"types": "./dist/jsx-runtime.d.ts",
			"default": "./dist/jsx-runtime.js"
		},
		"./jsx-dev-runtime": {
			"types": "./dist/jsx-dev-runtime.d.ts",
			"default": "./dist/jsx-dev-runtime.js"
		}
	},
	"files": [
		"dist",
		"skills",
		"AI_GUIDE.md"
	],
	"scripts": {
		"build": "tsup src/index.ts src/jsx-runtime.ts src/jsx-dev-runtime.ts --format esm --dts --clean",
		"test": "node -e \"process.exit(0)\"",
		"lint": "node -e \"process.exit(0)\""
	}
}
